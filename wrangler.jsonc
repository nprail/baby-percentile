{
  "name": "baby-percentile",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Built app from ./dist (npm run build); only /api/* runs the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // database_id is filled in automatically by `wrangler deploy` (resource provisioning).
  "d1_databases": [
    { "binding": "DB", "database_name": "baby-percentile", "migrations_dir": "migrations" }
  ],
  // Daily cleanup of expired profiles (see src/worker.js).
  "triggers": { "crons": ["17 4 * * *"] },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
